SPHINXOPTS ?=
SPHINXBUILD ?= uv run --project .. --locked --group docs sphinx-build
SOURCEDIR = .
BUILDDIR = _build

.PHONY: help Makefile

help:
	@$(SPHINXBUILD) -M help "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)

%: Makefile
	@$(SPHINXBUILD) -M $@ "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)
